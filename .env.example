# Copy to .env and adjust. These feed docker-compose.yml.
# The same login + key must be entered in the PrestaShop module configuration.

IFIRMA_USER=test@example.com
# 64 hex chars (32 bytes). Any valid even-length hex string works for the mock.
IFIRMA_KEY_FAKTURA=1111111111111111111111111111111111111111111111111111111111111111

# PrestaShop back-office admin account (auto-installed on first boot)
ADMIN_MAIL=admin@example.com
ADMIN_PASSWD=Passw0rd!

# Mock state file inside the container (empty = memory only; the compose file sets it).
# IFIRMA_MOCK_STATE_FILE=/data/ifirma-mock-state.json
# true = start the mock with an empty state (make up-clean); false keeps the stored state.
# IFIRMA_MOCK_CLEAN_START=false
